package cursos1;

import java.util.Random;

public class Curso {

	private final String nombreCurso;
	private final int cantidadMax;
	private final int cantidadInscritos;

	{
		Random random = new Random();
		cantidadMax = random.nextInt(35 - 20 + 1) + 20;
	}

	
	public Curso(String nombreCurso, int cantidadInscritos) {
		this.nombreCurso = nombreCurso;
		if (cantidadMax<cantidadInscritos) {
			System.out.println("El número de alumnos no puede exceder a: "+cantidadMax);
			this.cantidadInscritos=cantidadMax;
		}else {
			this.cantidadInscritos=cantidadInscritos;
		}
	}
	

	public String getNombreCurso() {
		return nombreCurso;
	}

	public int getCantidadMax() {
		return cantidadMax;
	}

	public int getCantidadInscritos() {
		return cantidadInscritos;
	}


	public String toString() {
		return "El curso " + this.nombreCurso + " tiene " + this.cantidadInscritos+ " alumnos";	
	}
	
Main	

}


